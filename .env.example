# ── Скопируйте этот файл в .env и заполните ──────────────────────────────────

# PostgreSQL connection string (получить на Render после создания БД)
DATABASE_URL=postgresql://user:password@localhost:5432/unitalk

# Секретный ключ для JWT — замените на любую длинную строку
JWT_SECRET=замените-на-длинную-случайную-строку-минимум-32-символа

# Окружение: development | production
NODE_ENV=development

# Порт (на Render выставляется автоматически)
PORT=3000

# (Опционально) Данные для createadmin.js
ADMIN_EMAIL=admin@unitalk.ru
ADMIN_PASSWORD=UniTalk@Admin2025
