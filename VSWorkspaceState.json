app.post('/consultations', auth(['applicant']), async (req, res) => {
  const student = await dbGet("SELECT * FROM users WHERE id=? AND role='student'", [req.body.studentId]);
  const pkg = CONSULTATION_PACKAGES.find(p => p.key === req.body.package);
  const topic = (req.body.topic || '').trim();
  if (!student || !pkg || !topic) return res.status(400).send('Некорректные данные запроса');

  const me = await dbGet('SELECT * FROM users WHERE id=?', [req.user.id]);
  if (me.coins < pkg.coins) {
    return res.status(400).send(`Недостаточно коинов. Нужно ${pkg.coins}, на балансе ${me.coins}. Пополните баланс на странице «Коины».`);
  }

  const payerKopecks = kopecksForCoins(pkg.coins);
  const payeeKopecks = studentShareKopecks(pkg.coins);

  await pool.query('UPDATE users SET coins = coins - $1 WHERE id=$2', [pkg.coins, req.user.id]);
  await pool.query(
    `INSERT INTO coin_transactions (user_id,type,amount,description) VALUES ($1,'message_charge',$2,$3)`,
    [req.user.id, -pkg.coins, `Оплата консультации «${pkg.label}» со студентом ${student.full_name}`]
  );
  const consult = await pool.query(
    `INSERT INTO consultations (applicant_id,student_id,topic,price_coins,payer_kopecks,payee_kopecks,message_limit)
     VALUES ($1,$2,$3,$4,$5,$6,$7) RETURNING id`,
    [req.user.id, student.id, topic, pkg.coins, payerKopecks, payeeKopecks, pkg.messageLimit]
  );
  const consultationId = consult.rows[0].id;
  await pool.query(
    'INSERT INTO consultation_messages (consultation_id,sender_id,content) VALUES ($1,$2,$3)',
    [consultationId, req.user.id, topic]
  );
  await pool.query('UPDATE consultations SET messages_used = 1 WHERE id=$1', [consultationId]);

  res.redirect('/consultations/' + consultationId);
});

app.get('/consultations/:id', auth(), async (req, res) => {
  const consultation = await dbGet(`
    SELECT c.*, a.full_name AS applicant_name, a.avatar AS applicant_avatar,
           s.full_name AS student_name, s.avatar AS student_avatar
    FROM consultations c
    JOIN users a ON a.id = c.applicant_id
    JOIN users s ON s.id = c.student_id
    WHERE c.id=?`, [req.params.id]);
  if (!consultation) return res.status(404).send('Консультация не найдена');
  if (req.user.id !== consultation.applicant_id && req.user.id !== consultation.student_id && req.user.role !== 'admin') {
    return res.status(403).send('Нет доступа');
  }
  const messages = await dbAll(`
    SELECT cm.*, u.full_name, u.avatar FROM consultation_messages cm
    JOIN users u ON u.id = cm.sender_id
    WHERE cm.consultation_id=? ORDER BY cm.created_at ASC`, [req.params.id]);
  const dispute = await dbGet(
    "SELECT * FROM consultation_disputes WHERE consultation_id=? ORDER BY created_at DESC LIMIT 1", [req.params.id]
  );
  const partner = req.user.id === consultation.applicant_id
    ? { id: consultation.student_id, full_name: consultation.student_name, avatar: consultation.student_avatar, role: 'student' }
    : { id: consultation.applicant_id, full_name: consultation.applicant_name, avatar: consultation.applicant_avatar, role: 'applicant' };
  res.render('consultation', { consultation, messages, partner, dispute });
});

app.post('/consultations/:id/dispute', auth(['applicant']), async (req, res) => {
  const consultation = await dbGet(
    "SELECT * FROM consultations WHERE id=? AND applicant_id=?", [req.params.id, req.user.id]
  );
  if (!consultation) return res.status(404).json({ error: 'Не найдено' });
  const existing = await dbGet(
    "SELECT id FROM consultation_disputes WHERE consultation_id=? AND status='pending'", [req.params.id]
  );
  if (existing) return res.status(400).json({ error: 'Апелляция уже подана и рассматривается' });
  await pool.query(
    'INSERT INTO consultation_disputes (consultation_id, reason) VALUES ($1,$2)',
    [req.params.id, (req.body.reason || '').slice(0, 500)]
  );
  await pool.query("UPDATE consultations SET status='disputed' WHERE id=$1", [req.params.id]);
  res.json({ ok: true });
});

