});

// Approve dispute = refund the applicant their coins (only if student wasn't paid yet)
app.post('/admin/appeals/:id/refund', auth(['admin']), async (req, res) => {
  const dispute = await dbGet("SELECT * FROM consultation_disputes WHERE id=? AND status='pending'", [req.params.id]);
  if (dispute) {
    const consultation = await dbGet('SELECT * FROM consultations WHERE id=?', [dispute.consultation_id]);
    await pool.query("UPDATE consultation_disputes SET status='refunded', resolved_at=NOW() WHERE id=$1", [dispute.id]);
    await pool.query("UPDATE consultations SET status='refunded' WHERE id=$1", [consultation.id]);
    await pool.query('UPDATE users SET coins = coins + $1 WHERE id=$2', [consultation.price_coins, consultation.applicant_id]);
    await pool.query(
      `INSERT INTO coin_transactions (user_id,type,amount,description) VALUES ($1,'message_refund',$2,$3)`,
      [consultation.applicant_id, consultation.price_coins, `Возврат по апелляции (консультация #${consultation.id})`]
    );
    if (consultation.payee_credited) {
      await pool.query('UPDATE users SET earned_kopecks = earned_kopecks - $1 WHERE id=$2',
        [consultation.payee_kopecks, consultation.student_id]);
    }
  }
  res.redirect('/admin/appeals');
});

// Reject dispute = consultation stands, student keeps/gets their share
app.post('/admin/appeals/:id/reject', auth(['admin']), async (req, res) => {
  const dispute = await dbGet("SELECT * FROM consultation_disputes WHERE id=? AND status='pending'", [req.params.id]);
  if (dispute) {
    const consultation = await dbGet('SELECT * FROM consultations WHERE id=?', [dispute.consultation_id]);
    await pool.query("UPDATE consultation_disputes SET status='rejected', resolved_at=NOW() WHERE id=$1", [dispute.id]);
    await pool.query("UPDATE consultations SET status='completed' WHERE id=$1", [consultation.id]);
    if (!consultation.payee_credited) {
      await pool.query('UPDATE users SET earned_kopecks = earned_kopecks + $1 WHERE id=$2',
        [consultation.payee_kopecks, consultation.student_id]);
      await pool.query('UPDATE consultations SET payee_credited = TRUE WHERE id=$1', [consultation.id]);
      await pool.query(
        `INSERT INTO coin_transactions (user_id,type,amount,description) VALUES ($1,'message_charge',0,$2)`,
        [consultation.student_id, `Апелляция отклонена, начислено ${(consultation.payee_kopecks/100).toFixed(2)}₽ (консультация #${consultation.id})`]
      );
    }
  }
  res.redirect('/admin/appeals');
});

app.post('/admin/payouts/:id/paid', auth(['admin']), async (req, res) => {
  const payout = await dbGet("SELECT * FROM payout_requests WHERE id=? AND status='pending'", [req.params.id]);
