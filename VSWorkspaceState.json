    FROM consultation_disputes d
    JOIN consultations c ON c.id = d.consultation_id
    JOIN users a ON a.id = c.applicant_id
    JOIN users s ON s.id = c.student_id
    WHERE d.status='pending' ORDER BY d.created_at ASC`);
  const payouts = await dbAll(`
