    await pool.query(
      `INSERT INTO coin_transactions (user_id,type,amount,description) VALUES ($1,'payout_paid',0,$2)`,
      [payout.user_id, `Выплата произведена вручную: ${(payout.amount_kopecks/100).toFixed(2)}₽`]
    );
