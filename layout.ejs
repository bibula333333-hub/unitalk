<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
  <h1>❓ Вопросы и ответы</h1>
  <% if (locals.user) { %>
    <a href="/questions/ask" class="btn btn-primary">✏️ Задать вопрос</a>
  <% } else { %>
    <a href="/login" class="btn btn-outline">Войдите, чтобы задать вопрос</a>
  <% } %>
</div>

<!-- Filter by university -->
<form method="GET" action="/questions" style="display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;">
  <select name="university_id" class="form-input" style="max-width:300px;" onchange="this.form.submit()">
    <option value="">🏫 Все вузы</option>
    <% universities.forEach(u => { %>
      <option value="<%= u.id %>" <%= uniFilter == u.id ? 'selected' : '' %>><%= u.name %></option>
    <% }); %>
  </select>
  <% if (uniFilter) { %>
    <a href="/questions" class="btn btn-outline">✕ Сбросить</a>
  <% } %>
</form>

<% if (questions.length === 0) { %>
  <div class="card" style="text-align:center;padding:3rem;">
    <p style="font-size:1.5rem;margin-bottom:0.5rem;">🤔</p>
    <p style="color:var(--text-secondary);">Вопросов пока нет. Задайте первый!</p>
    <% if (locals.user) { %>
      <a href="/questions/ask" class="btn btn-primary" style="margin-top:1rem;">Задать вопрос</a>
    <% } %>
  </div>
<% } %>

<div style="display:flex;flex-direction:column;gap:1rem;">
  <% questions.forEach(q => { %>
    <a href="/questions/<%= q.id %>" class="card" style="text-decoration:none;color:inherit;display:block;">
      <div style="display:flex;gap:1rem;align-items:flex-start;">
        <img src="<%= q.author_avatar %>" alt=""
             style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;">
        <div style="flex:1;min-width:0;">
          <h3 style="margin-bottom:0.3rem;color:var(--primary-color);"><%= q.title %></h3>
          <p style="color:var(--text-secondary);font-size:0.875rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
            <%= q.content.substring(0,150) %><%= q.content.length>150?'…':'' %>
          </p>
          <div style="display:flex;align-items:center;gap:1rem;margin-top:0.5rem;font-size:0.8rem;color:var(--text-secondary);flex-wrap:wrap;">
            <span><%= q.author_name %></span>
            <% if (q.university_name) { %><span>🏫 <%= q.university_name %></span><% } %>
            <% if (q.faculty_name) { %><span>📚 <%= q.faculty_name %></span><% } %>
            <span><%= new Date(q.created_at).toLocaleDateString('ru-RU') %></span>
            <span style="margin-left:auto;background:var(--bg-secondary);padding:0.2rem 0.6rem;border-radius:1rem;">
              💬 <%= q.answer_count %> <%= q.answer_count==1?'ответ':q.answer_count<5?'ответа':'ответов' %>
            </span>
          </div>
        </div>
      </div>
    </a>
  <% }); %>
</div>
