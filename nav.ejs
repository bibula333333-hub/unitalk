<div style="max-width:700px;margin:0 auto;">
  <h1>💡 Предложить вуз</h1>
  <p style="color:var(--text-secondary);margin-bottom:1.5rem;">
    Если вашего вуза нет на сайте — предложите его добавить. Модератор рассмотрит заявку и добавит вуз.
  </p>

  <% if (locals.query && locals.query.sent == '1' || (locals.req && req.query.sent)) { %>
  <% } %>

  <% if (locals.user && (user.role === 'student' || user.role === 'admin')) { %>
    <div class="card" style="margin-bottom:2rem;">
      <h2 style="margin-bottom:1rem;">📋 Новая заявка</h2>
      <form action="/suggestions" method="POST">
        <div class="form-group">
          <label class="form-label">Название вуза *</label>
          <input type="text" name="university_name" class="form-input" required
                 placeholder="Московский государственный технический университет">
        </div>
        <div class="form-group">
          <label class="form-label">Город</label>
          <input type="text" name="city" class="form-input" placeholder="Москва">
        </div>
        <div class="form-group">
          <label class="form-label">Факультеты (перечислите через запятую)</label>
          <textarea name="faculties" class="form-input" rows="3"
                    placeholder="Факультет информационных технологий, Механический факультет, Экономический факультет…"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Краткое описание вуза</label>
          <textarea name="description" class="form-input" rows="3"
                    placeholder="Расскажите о вузе: когда основан, особенности, сильные стороны…"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">📤 Отправить заявку</button>
      </form>
    </div>
  <% } else if (!locals.user) { %>
    <div class="card" style="text-align:center;padding:2rem;margin-bottom:2rem;">
      <p><a href="/login" style="color:var(--primary-color);">Войдите</a>, чтобы предложить вуз</p>
    </div>
  <% } else { %>
    <div class="card" style="text-align:center;padding:2rem;margin-bottom:2rem;background:#FEF3C7;">
      <p style="color:#92400E;">Предлагать вузы могут только студенты и администраторы</p>
    </div>
  <% } %>

  <!-- My suggestions -->
  <h2>Мои заявки (<%= mySuggestions.length %>)</h2>
  <% if (mySuggestions.length === 0) { %>
    <p style="color:var(--text-secondary);">У вас пока нет заявок</p>
  <% } %>
  <% mySuggestions.forEach(sg => { %>
    <div class="card" style="border-left:4px solid
      <%= sg.status==='approved'?'#10B981':sg.status==='rejected'?'#EF4444':'#F59E0B' %>;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;">
        <div>
          <strong><%= sg.university_name %></strong>
          <% if (sg.city) { %><span style="color:var(--text-secondary);"> · <%= sg.city %></span><% } %>
          <% if (sg.faculties) { %><p style="font-size:0.85rem;color:var(--text-secondary);margin-top:0.25rem;">Факультеты: <%= sg.faculties %></p><% } %>
          <p style="font-size:0.75rem;color:var(--text-secondary);margin-top:0.4rem;">
            <%= new Date(sg.created_at).toLocaleDateString('ru-RU') %>
          </p>
        </div>
        <span style="font-size:0.8rem;padding:0.25rem 0.7rem;border-radius:1rem;font-weight:600;white-space:nowrap;
          background:<%= sg.status==='approved'?'#D1FAE5':sg.status==='rejected'?'#FEE2E2':'#FEF3C7' %>;
          color:<%= sg.status==='approved'?'#065F46':sg.status==='rejected'?'#991B1B':'#92400E' %>;">
          <%= sg.status==='approved'?'✅ Одобрено':sg.status==='rejected'?'❌ Отклонено':'⏳ На рассмотрении' %>
        </span>
      </div>
    </div>
  <% }); %>
</div>
