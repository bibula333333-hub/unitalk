<div style="max-width:760px;margin:0 auto;">
  <a href="/news" style="color:var(--primary-color);text-decoration:none;">← Все новости</a>

  <div class="card" style="margin-top:1rem;">
    <% if (article.image_url) { %>
      <img src="<%= article.image_url %>" alt=""
           style="width:100%;height:320px;object-fit:cover;border-radius:0.5rem;margin-bottom:1.5rem;">
    <% } %>

    <h1 style="margin-bottom:0.75rem;"><%= article.title %></h1>

    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border-color);">
      <img src="<%= article.author_avatar %>" alt="" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">
      <div>
        <a href="/user/<%= article.author_id %>" style="color:inherit;text-decoration:none;font-weight:600;"><%= article.author_name %></a>
        <p style="color:var(--text-secondary);font-size:0.8rem;margin:0;">
          📰 Репортёр · <%= new Date(article.created_at).toLocaleDateString('ru-RU', {day:'numeric',month:'long',year:'numeric'}) %>
        </p>
      </div>
      <% if (locals.user && (user.role === 'admin' || (user.role === 'reporter' && user.id === article.author_id))) { %>
        <form action="/news/<%= article.id %>/delete" method="POST" style="margin-left:auto;"
              onsubmit="return confirm('Удалить эту новость?')">
          <button type="submit" class="btn btn-danger" style="padding:0.3rem 0.8rem;font-size:0.85rem;">🗑 Удалить</button>
        </form>
      <% } %>
    </div>

    <div style="line-height:1.75;font-size:1.05rem;white-space:pre-wrap;"><%= article.content %></div>
  </div>
</div>
