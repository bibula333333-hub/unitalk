<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
  <h1>💡 Заявки на добавление вузов</h1>
  <a href="/admin" class="btn btn-outline">← Назад к панели</a>
</div>

<% const pending  = suggestions.filter(s => s.status === 'pending'); %>
<% const resolved = suggestions.filter(s => s.status !== 'pending'); %>

<% if (pending.length === 0 && resolved.length === 0) { %>
  <div class="card" style="text-align:center;padding:3rem;">
    <p style="font-size:1.5rem;margin-bottom:0.5rem;">📭</p>
    <p style="color:var(--text-secondary);">Заявок пока нет</p>
  </div>
<% } %>

<% if (pending.length > 0) { %>
  <h2 style="margin-bottom:0.75rem;">⏳ На рассмотрении (<%= pending.length %>)</h2>
  <% pending.forEach(sg => { %>
    <div class="card" style="border-left:4px solid #F59E0B;margin-bottom:0.85rem;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
            <img src="<%= sg.author_avatar %>" alt="" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
            <span style="color:var(--text-secondary);font-size:0.85rem;"><%= sg.author_name %></span>
            <span style="color:var(--text-secondary);font-size:0.8rem;"><%= new Date(sg.created_at).toLocaleDateString('ru-RU') %></span>
          </div>
          <strong style="font-size:1.05rem;"><%= sg.university_name %></strong>
          <% if (sg.city) { %><span style="color:var(--text-secondary);"> · 📍 <%= sg.city %></span><% } %>
          <% if (sg.faculties) { %>
            <p style="margin-top:0.4rem;font-size:0.875rem;"><strong>Факультеты:</strong> <%= sg.faculties %></p>
          <% } %>
          <% if (sg.description) { %>
            <p style="margin-top:0.3rem;font-size:0.875rem;color:var(--text-secondary);"><%= sg.description %></p>
          <% } %>
        </div>
        <div style="display:flex;flex-direction:column;gap:0.5rem;flex-shrink:0;">
          <form action="/admin/suggestions/<%= sg.id %>/approve" method="POST">
            <button type="submit" style="padding:0.4rem 1rem;background:#10B981;color:white;border:none;border-radius:0.5rem;cursor:pointer;font-weight:600;width:100%;">
              ✅ Одобрить и добавить вуз
            </button>
          </form>
          <form action="/admin/suggestions/<%= sg.id %>/reject" method="POST" onsubmit="return confirm('Отклонить заявку?')">
            <button type="submit" class="btn btn-danger" style="padding:0.4rem 1rem;width:100%;">❌ Отклонить</button>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<% if (resolved.length > 0) { %>
  <h2 style="margin-top:2rem;margin-bottom:0.75rem;">📋 Обработанные заявки (<%= resolved.length %>)</h2>
  <% resolved.forEach(sg => { %>
    <div class="card" style="border-left:4px solid <%= sg.status==='approved'?'#10B981':'#EF4444' %>;opacity:0.75;">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <strong><%= sg.university_name %></strong>
          <% if (sg.city) { %><span style="color:var(--text-secondary);"> · <%= sg.city %></span><% } %>
          <span style="color:var(--text-secondary);font-size:0.8rem;margin-left:0.5rem;">от <%= sg.author_name %></span>
        </div>
        <span style="font-size:0.8rem;padding:0.2rem 0.6rem;border-radius:1rem;font-weight:600;
          background:<%= sg.status==='approved'?'#D1FAE5':'#FEE2E2' %>;
          color:<%= sg.status==='approved'?'#065F46':'#991B1B' %>;">
          <%= sg.status==='approved'?'✅ Одобрено':'❌ Отклонено' %>
        </span>
      </div>
    </div>
  <% }); %>
<% } %>
