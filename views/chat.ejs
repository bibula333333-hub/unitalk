<style>
.chat-wrap { display: flex; flex-direction: column; height: calc(100vh - 160px); min-height: 400px; }
.chat-header { padding: 1rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
.chat-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
.msg { max-width: 70%; padding: 0.6rem 0.9rem; border-radius: 1rem; font-size: 0.95rem; line-height: 1.4; word-break: break-word; }
.msg-incoming { align-self: flex-start; background: var(--bg-secondary); border-bottom-left-radius: 0.2rem; }
.msg-outgoing { align-self: flex-end; background: var(--primary-color); color: white; border-bottom-right-radius: 0.2rem; }
.msg-meta { font-size: 0.72rem; opacity: 0.65; margin-bottom: 0.2rem; }
.msg-outgoing .msg-meta { text-align: right; }
.chat-form { display: flex; gap: 0.75rem; padding: 0.85rem 1rem; border-top: 1px solid var(--border-color); flex-shrink: 0; }
.chat-form input { flex: 1; }
</style>

<a href="/chats" style="color:var(--primary-color);text-decoration:none;display:block;margin-bottom:0.75rem;">← Назад к чатам</a>

<div class="card chat-wrap" style="padding:0;">
  <div class="chat-header">
    <img src="<%= partner.avatar %>" alt="" style="width:44px;height:44px;border-radius:50%;object-fit:cover;">
    <div>
      <strong><a href="/user/<%= partner.id %>" style="color:inherit;text-decoration:none;"><%= partner.full_name %></a></strong>
      <p style="color:var(--text-secondary);font-size:0.8rem;margin:0;">
        <%= partner.role === 'admin' ? '👑 Администратор' : partner.role === 'student' ? '🎓 Студент' : partner.role === 'reporter' ? '📰 Репортёр' : '📚 Абитуриент' %>
      </p>
    </div>
  </div>

  <div class="chat-messages" id="msgBox">
    <% messages.forEach(m => { %>
      <div>
        <div class="msg-meta" style="<%= m.sender_id === user.id ? 'text-align:right;' : '' %>">
          <%= m.sender_id === user.id ? 'Вы' : m.full_name %> · <%= new Date(m.created_at).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}) %>
        </div>
        <div class="msg <%= m.sender_id === user.id ? 'msg-outgoing' : 'msg-incoming' %>">
          <%- m.content.replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>') %>
        </div>
      </div>
    <% }); %>
  </div>

  <form class="chat-form" id="chatForm">
    <input id="msgInput" class="form-input" placeholder="Введите сообщение…" autocomplete="off">
    <button type="submit" class="btn btn-primary">Отправить</button>
  </form>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
  const CHAT_ID = <%= chat.id %>;
  const USER_ID = <%= user.id %>;
  const socket  = io();
  const box     = document.getElementById('msgBox');

  socket.emit('join_chat', CHAT_ID);
  box.scrollTop = box.scrollHeight;

  document.getElementById('chatForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const inp  = document.getElementById('msgInput');
    const text = inp.value.trim();
    if (!text) return;
    socket.emit('send_message', { chatId: CHAT_ID, senderId: USER_ID, content: text });
    inp.value = '';
    inp.focus();
  });

  socket.on('new_message', function(msg) {
    const isOwn = msg.sender_id === USER_ID;
    const time  = new Date(msg.created_at).toLocaleTimeString('ru-RU', { hour:'2-digit', minute:'2-digit' });
    const safe  = msg.content.replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
    const html  = `
      <div>
        <div class="msg-meta" style="${isOwn ? 'text-align:right;' : ''}">${isOwn ? 'Вы' : msg.full_name} · ${time}</div>
        <div class="msg ${isOwn ? 'msg-outgoing' : 'msg-incoming'}">${safe}</div>
      </div>`;
    box.insertAdjacentHTML('beforeend', html);
    box.scrollTop = box.scrollHeight;
  });

  socket.on('connect_error', function() {
    console.warn('Socket.IO не подключён — сообщения не обновятся в реальном времени');
  });
})();
</script>
