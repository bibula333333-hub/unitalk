<div class="text-center mt-2">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">Общайтесь с реальными студентами</h1>
    <p style="font-size: 1.25rem; color: var(--text-secondary); margin-bottom: 2rem;">
        Задайте вопросы о поступлении, учебе и жизни в вузе тем, кто уже там учится
    </p>
    <% if (!locals.user) { %>
        <a href="/register" class="btn btn-primary" style="font-size: 1.25rem; padding: 1rem 2rem;">
            Начать общение
        </a>
    <% } %>
</div>

<div class="mt-2">
    <h2>Популярные вузы</h2>
    <div class="grid grid-3">
        <% universities.slice(0, 6).forEach(university => { %>
            <a href="/universities/<%= university.id %>" class="card" style="text-decoration: none; color: inherit;">
                <h3><%= university.name %></h3>
                <% if (university.city) { %>
                    <p style="color: var(--text-secondary);">📍 <%= university.city %></p>
                <% } %>
            </a>
        <% }); %>
    </div>
</div>

<% if (recentReviews.length > 0) { %>
    <div class="mt-2">
        <h2>Последние отзывы</h2>
        <% recentReviews.forEach(review => { %>
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: start;">
                    <div>
                        <strong><%= review.full_name %></strong>
                        <span style="color: var(--text-secondary);">о <%= review.university_name %></span>
                        <% if (review.faculty_name) { %>
                            <span style="color: var(--text-secondary);">• <%= review.faculty_name %></span>
                        <% } %>
                    </div>
                    <div class="stars">
                        <% for (let i = 0; i < review.rating; i++) { %>★<% } %>
                        <% for (let i = review.rating; i < 5; i++) { %>☆<% } %>
                    </div>
                </div>
                <p style="margin-top: 0.5rem;"><%= review.content %></p>
            </div>
        <% }); %>
    </div>
<% } %>