<div style="max-width:760px;margin:0 auto;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
    <h1>✍️ Написать новость</h1>
    <a href="/news" class="btn btn-outline">← Назад</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error" style="margin-bottom:1rem;"><%= error %></div>
  <% } %>

  <div class="card">
    <form action="/news/create" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Заголовок *</label>
        <input type="text" name="title" class="form-input" required maxlength="200"
               placeholder="Введите заголовок новости">
      </div>
      <div class="form-group">
        <label class="form-label">Текст новости *</label>
        <textarea name="content" class="form-input" rows="12" required
                  placeholder="Напишите текст новости…" style="resize:vertical;"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Изображение (необязательно)</label>
        <input type="file" name="image" class="form-input" accept="image/*">
        <p style="color:var(--text-secondary);font-size:0.8rem;margin-top:0.25rem;">JPG, PNG, WEBP — до 5 МБ</p>
      </div>
      <div style="display:flex;gap:1rem;">
        <button type="submit" class="btn btn-primary">📤 Опубликовать</button>
        <a href="/news" class="btn btn-outline">Отмена</a>
      </div>
    </form>
  </div>
</div>
