<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
	<h1>✏️ Редактировать вуз</h1>
	<a href="/admin#universities" class="btn btn-outline">← Назад</a>
</div>

<div class="card" style="max-width: 600px;">
	<form action="/admin/universities/<%= university.id %>/edit" method="POST">
		<div class="form-group">
			<label class="form-label">Название вуза *</label>
			<input type="text" name="name" class="form-input" required value="<%= university.name %>">
		</div>
		<div class="form-group">
			<label class="form-label">Город</label>
			<input type="text" name="city" class="form-input" value="<%= university.city || '' %>">
		</div>
		<div class="form-group">
			<label class="form-label">Описание</label>
			<textarea name="description" class="form-input" rows="6" placeholder="Расскажите о вузе: история, особенности, достижения..."><%= university.description || '' %></textarea>
		</div>
		<div style="display: flex; gap: 1rem;">
			<button type="submit" class="btn btn-primary">💾 Сохранить изменения</button>
			<a href="/admin#universities" class="btn btn-outline">Отмена</a>
		</div>
	</form>
</div>
